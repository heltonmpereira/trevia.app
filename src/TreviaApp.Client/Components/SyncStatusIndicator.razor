@using TreviaApp.Client.Services
@using TreviaApp.Client.Services.Auth

@inject ISyncQueue SyncQueue
@inject ICurrentUserIdProvider UserIdProvider
@inject IAuthService AuthService
@implements IAsyncDisposable

@if (_isAuthenticated)
{
<div class="d-inline-flex align-items-center gap-2 sync-inline @_indicatorClass" title="@_tooltipText" @onclick="HandleClick">
    <span>@_currentIcon</span>
    @if (_showText && _count > 0)
    {
        <span class="sync-count">@_count</span>
    }
    @if (_showText && _statusText != null)
    {
        <span class="small d-none d-sm-inline">@_statusText</span>
    }
</div>

@if (_showDetailPanel)
{
    <div class="sync-detail-panel" @onclick:stopPropagation="true">
        <div class="sync-detail-header">
            <strong>Sincronização</strong>
            <button class="sync-close-btn" @onclick="() => _showDetailPanel = false">✕</button>
        </div>
        <div class="sync-detail-body">
            <div class="sync-detail-row">
                <span class="sync-row-icon">🌐</span>
                <span>Conexão:</span>
                <strong class="@(_status?.IsOnline == true ? "text-success" : "text-danger")">
                    @(_status?.IsOnline == true ? "Online" : "Offline")
                </strong>
            </div>
            <div class="sync-detail-row"><span class="sync-row-icon">⏳</span><span>Pendentes:</span><strong>@(_status?.Pending ?? 0)</strong></div>
            <div class="sync-detail-row"><span class="sync-row-icon">⚙️</span><span>Processando:</span><strong>@(_status?.Processing ?? 0)</strong></div>
            <div class="sync-detail-row"><span class="sync-row-icon">⚠️</span><span>Falhas:</span><strong class="@(_status?.Failed > 0 ? "text-danger" : "")">@(_status?.Failed ?? 0)</strong></div>
            <div class="sync-detail-row"><span class="sync-row-icon">✅</span><span>Concluídas:</span><strong>@(_status?.Completed ?? 0)</strong></div>
        </div>
        <div class="sync-detail-footer">
            <button class="btn btn-sm btn-outline-primary" @onclick="ForceSyncNow">
                🔄 Sincronizar agora
            </button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearCompleted">
                🧹 Limpar concluídas
            </button>
        </div>
        @if (_status?.FailedItems?.Any() == true)
        {
            <div class="sync-detail-errors">
                <h6 class="mt-2 mb-1 text-danger">Últimas falhas:</h6>
                <ul class="list-unstyled">
                    @foreach (var f in _status.FailedItems.Take(3))
                    {
                        <li class="small text-danger py-1 border-top">
                            <strong>@f.OperationType</strong>: @f.LastError
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
}
}

<style>
.sync-inline {
    padding: 0.3rem 0.75rem;
    border-radius: 100px;
    font-weight: 600;
    cursor: pointer;
    border: 1px solid transparent;
    transition: all 0.2s ease;
    user-select: none;
    line-height: 1;
}
.sync-inline:hover { transform: scale(1.03); }

.sync-synced { background: rgba(240, 253, 244, 0.9); color: #15803d; border-color: #bbf7d0; }
.sync-pending { background: rgba(239, 246, 255, 0.9); color: #1d4ed8; border-color: #bfdbfe; }
.sync-processing { background: rgba(254, 249, 195, 0.9); color: #a16207; border-color: #fde68a; }
.sync-failed { background: rgba(254, 242, 242, 0.9); color: #b91c1c; border-color: #fecaca; }
.sync-offline { background: rgba(243, 244, 246, 0.9); color: #475569; border-color: #e2e8f0; }

.sync-count {
    display: inline-block;
    min-width: 1.3rem;
    padding: 0.08rem 0.45rem;
    border-radius: 100px;
    background: currentColor;
    color: white;
    font-size: 0.7rem;
    line-height: 1.1;
    text-align: center;
}

.sync-detail-panel {
    position: fixed;
    top: 3rem;
    right: 0.5rem;
    z-index: 1060;
    width: 300px;
    max-width: calc(100vw - 1rem);
    background: white;
    border-radius: 14px;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.2);
    overflow: hidden;
    border: 1px solid #e2e8f0;
    animation: slideInRight 0.2s ease-out;
}
@@keyframes slideInRight { from { transform: translateX(10px); opacity: 0; } to { transform: translateX(0); opacity: 1; } }

.sync-detail-header {
    padding: 0.75rem 1rem;
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    display: flex;
    justify-content: space-between;
    align-items: center;
}
.sync-close-btn {
    background: none;
    border: none;
    color: #64748b;
    font-size: 1rem;
    cursor: pointer;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
}
.sync-close-btn:hover { background: #e2e8f0; }

.sync-detail-body { padding: 0.75rem 1rem; }
.sync-detail-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.25rem 0;
    font-size: 0.88rem;
    gap: 0.5rem;
}
.sync-row-icon { font-size: 1rem; }

.sync-detail-footer {
    padding: 0.75rem 1rem;
    border-top: 1px solid #e2e8f0;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}
.sync-detail-errors { padding: 0 1rem 1rem; }

@@media (max-width: 420px) {
    .sync-inline { padding: 0.25rem 0.5rem; }
    .sync-detail-panel { top: auto; bottom: 0.5rem; right: 0.5rem; }
}
</style>

@code {
    [Parameter] public bool ShowText { get; set; } = true;

    private SyncStatusSummary? _status;
    private bool _showDetailPanel;
    private string? _userId;
    private bool _isAuthenticated;
    private System.Threading.Timer? _pollTimer;

    private bool _showText => ShowText;
    private int _count => _status?.Pending + _status?.Failed ?? 0;

    private string _currentIcon =>
        (_status?.IsOnline ?? true) switch
        {
            false => "📡",
            true when (_status?.Failed ?? 0) > 0 => "⚠️",
            true when (_status?.Processing ?? 0) > 0 => "⚙️",
            true when (_status?.Pending ?? 0) > 0 => "🔄",
            _ => "✅"
        };

    private string _indicatorClass =>
        (_status?.IsOnline ?? true) switch
        {
            false => "sync-offline",
            true when (_status?.Failed ?? 0) > 0 => "sync-failed",
            true when (_status?.Processing ?? 0) > 0 => "sync-processing",
            true when (_status?.Pending ?? 0) > 0 => "sync-pending",
            _ => "sync-synced"
        };

    private string? _statusText =>
        (_status?.IsOnline ?? true) switch
        {
            false => "Offline",
            true when (_status?.Failed ?? 0) > 0 => $"{_status?.Failed} falha(s)",
            true when (_status?.Processing ?? 0) > 0 => "Sincronizando",
            true when (_status?.Pending ?? 0) > 0 => $"{_status?.Pending} pendente(s)",
            _ => "Sincronizado"
        };

    private string _tooltipText =>
        (_status?.IsOnline ?? true) switch
        {
            false => "Sem conexão - dados salvos localmente",
            true when (_status?.Failed ?? 0) > 0 => "Algumas operações falharam. Clique para detalhes.",
            true when (_status?.Processing ?? 0) > 0 => "Enviando dados para o servidor...",
            true when (_status?.Pending ?? 0) > 0 => $"{_status?.Pending} operações aguardando envio",
            _ => "Tudo sincronizado com sucesso"
        };

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthenticationChangedAsync += OnAuthenticationChanged;
        await CheckAuthAndInitAsync();
    }

    private async Task OnAuthenticationChanged()
    {
        await CheckAuthAndInitAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckAuthAndInitAsync()
    {
        try { _isAuthenticated = await AuthService.IsAuthenticatedAsync(); }
        catch { _isAuthenticated = false; }

        if (_isAuthenticated)
        {
            SyncQueue.OnStatusChanged += HandleStatusChanged;
            _userId = await UserIdProvider.GetCurrentUserIdAsync();
            if (_pollTimer == null)
            {
                _pollTimer = new System.Threading.Timer(async _ => await RefreshStatus(), null, 0, 8000);
            }
            await RefreshStatus();
        }
        else
        {
            SyncQueue.OnStatusChanged -= HandleStatusChanged;
            _pollTimer?.Dispose();
            _pollTimer = null;
            _userId = null;
            _status = null;
            _showDetailPanel = false;
        }
    }

    private async void HandleStatusChanged()
    {
        await RefreshStatus();
    }

    private async Task RefreshStatus()
    {
        if (!_isAuthenticated || string.IsNullOrEmpty(_userId)) return;
        try
        {
            _status = await SyncQueue.GetStatusSummaryAsync(_userId);
        }
        catch
        {
            _status = null;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void HandleClick()
    {
        _showDetailPanel = !_showDetailPanel;
    }

    private async Task ForceSyncNow()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        try
        {
            await SyncQueue.ProcessPendingAsync(_userId, _ => Task.FromResult(true));
        }
        finally
        {
            await RefreshStatus();
        }
    }

    private async Task ClearCompleted()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        await SyncQueue.ClearCompletedAsync(_userId);
        await RefreshStatus();
    }

    public ValueTask DisposeAsync()
    {
        AuthService.AuthenticationChangedAsync -= OnAuthenticationChanged;
        SyncQueue.OnStatusChanged -= HandleStatusChanged;
        _pollTimer?.Dispose();
        return ValueTask.CompletedTask;
    }
}
