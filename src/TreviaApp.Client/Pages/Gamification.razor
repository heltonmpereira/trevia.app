@page "/gamification"
@using TreviaApp.Contracts.Gamification.Responses
@using TreviaApp.Shared.Enums
@inject IGamificationService gamification

<PageTitle>Gamificação</PageTitle>

<div class="container py-4">
    <h1 class="mb-4">Gamificação</h1>

    @if (errorMessage != null)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Saldo de Pontos</h5>
                        <h2 class="display-4 fw-bold text-primary">@balance?.TotalPoints ?? 0</h2>
                        <div class="mt-3 small text-muted">
                            <div>Hoje: <strong class="text-dark">@balance?.PointsToday ?? 0</strong></div>
                            <div>Esta semana: <strong class="text-dark">@balance?.PointsThisWeek ?? 0</strong></div>
                            <div>Este mês: <strong class="text-dark">@balance?.PointsThisMonth ?? 0</strong></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Level Atual</h5>
                        <div class="d-flex align-items-center justify-content-between">
                            <h2 class="display-4 fw-bold text-success">Lv. @levelProgress?.CurrentLevel ?? 1</h2>
                        </div>
                        <div class="mt-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span>XP: @levelProgress?.CurrentXp ?? 0</span>
                                <span>Próximo: @levelProgress?.XpToNextLevel ?? 0</span>
                            </div>
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar bg-success" style="width:@(levelProgress?.ProgressPercentage ?? 0)%">
                                    @(levelProgress?.ProgressPercentage ?? 0).ToString("F0")%
                                </div>
                            </div>
                            <div class="mt-2 small text-muted">
                                Total XP: @levelProgress?.TotalXpEarned ?? 0
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title text-muted">Streaks</h5>
                        <div class="row g-3 mt-2">
                            <div class="col-6 text-center">
                                <div class="p-3 bg-light rounded">
                                    <div class="display-6 fw-bold text-warning">🔥 @streaks?.DailyCurrent ?? 0</div>
                                    <small class="text-muted">Atual (diário)</small>
                                </div>
                            </div>
                            <div class="col-6 text-center">
                                <div class="p-3 bg-light rounded">
                                    <div class="display-6 fw-bold text-info">📅 @streaks?.WeeklyCurrent ?? 0</div>
                                    <small class="text-muted">Semanal</small>
                                </div>
                            </div>
                            <div class="col-6 text-center">
                                <div class="p-3 bg-light rounded">
                                    <div class="display-6 fw-bold text-secondary">🏆 @streaks?.DailyLongest ?? 0</div>
                                    <small class="text-muted">Recorde diário</small>
                                </div>
                            </div>
                            <div class="col-6 text-center">
                                <div class="p-3 bg-light rounded">
                                    <div class="display-6 fw-bold text-dark">💪 @streaks?.WeeklyLongest ?? 0</div>
                                    <small class="text-muted">Recorde semanal</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Missões de Hoje</h5>
                    </div>
                    <div class="card-body">
                        @if (todayMissions == null || todayMissions.Count == 0)
                        {
                            <p class="text-muted text-center py-3">Nenhuma missão para hoje.</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var mission in todayMissions)
                                {
                                    <div class="list-group-item px-0">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="flex-grow-1 me-3">
                                                <div class="d-flex align-items-center gap-2">
                                                    <h6 class="mb-1">@mission.Title</h6>
                                                    @if (mission.IsClaimed)
                                                    {
                                                        <span class="badge bg-success">Resgatado</span>
                                                    }
                                                    else if (mission.IsCompleted)
                                                    {
                                                        <span class="badge bg-warning text-dark">Concluído</span>
                                                    }
                                                </div>
                                                <p class="small text-muted mb-2">@mission.Description</p>
                                                <div class="mb-2">
                                                    <div class="d-flex justify-content-between small mb-1">
                                                        <span>Progresso: @mission.CurrentValue/@mission.TargetValue</span>
                                                        <span>+@mission.PointsReward pts · +@mission.XpReward XP</span>
                                                    </div>
                                                    <div class="progress" style="height: 8px;">
                                                        <div class="progress-bar @(mission.IsCompleted ? "bg-success" : "bg-primary")" style="width:@mission.ProgressPercentage%"></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <div>
                                                @if (mission.IsCompleted && !mission.IsClaimed)
                                                {
                                                    <button class="btn btn-success btn-sm" @onclick="async () => await ClaimReward(mission)">
                                                        Resgatar
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-header">
                        <h5 class="mb-0">Conquistas Recentes</h5>
                    </div>
                    <div class="card-body p-0">
                        @if (recentAchievements == null || recentAchievements.Count == 0)
                        {
                            <p class="text-muted text-center py-4">Nenhuma conquista recente.</p>
                        }
                        else
                        {
                            <div class="list-group list-group-flush">
                                @foreach (var ach in recentAchievements)
                                {
                                    <div class="list-group-item d-flex align-items-center gap-3">
                                        <div class="fs-3">@(string.IsNullOrEmpty(ach.Icon) ? "🏅" : ach.Icon)</div>
                                        <div class="flex-grow-1">
                                            <h6 class="mb-0">@ach.Name</h6>
                                            <p class="small text-muted mb-1">@ach.Description</p>
                                            @if (ach.IsUnlocked && ach.UnlockedAt.HasValue)
                                            {
                                                <small class="text-success">Desbloqueado em @ach.UnlockedAt.Value.ToString("dd/MM/yyyy")</small>
                                            }
                                            else
                                            {
                                                <div class="progress" style="height: 6px;">
                                                    <div class="progress-bar bg-info" style="width:@ach.Progress%"></div>
                                                </div>
                                            }
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-primary">+@ach.PointsReward pts</span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-12">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Histórico de Pontos</h5>
                        <div class="d-flex gap-2 align-items-center">
                            <select class="form-select form-select-sm" value="@historyReason?.ToString()" @onchange="async (ChangeEventArgs e) => { historyReason = string.IsNullOrEmpty(e.Value?.ToString()) ? null : Enum.Parse<PointReason>(e.Value!.ToString()!); await LoadHistory(1); }">
                                <option value="">Todos os motivos</option>
                                @foreach (var r in Enum.GetValues<PointReason>())
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(historyPage <= 1)" @onclick="async () => await LoadHistory(historyPage - 1)">Anterior</button>
                            <span class="small">Página @historyPage</span>
                            <button class="btn btn-outline-secondary btn-sm" disabled="@(pointHistory == null || !pointHistory.HasNextPage)" @onclick="async () => await LoadHistory(historyPage + 1)">Próxima</button>
                        </div>
                    </div>
                    <div class="card-body p-0">
                        @if (pointHistory == null || pointHistory.Items.Count == 0)
                        {
                            <p class="text-muted text-center py-4">Nenhum registro encontrado.</p>
                        }
                        else
                        {
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Data</th>
                                        <th>Motivo</th>
                                        <th>Descrição</th>
                                        <th class="text-end">Pontos</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var ph in pointHistory.Items)
                                    {
                                        <tr>
                                            <td>@ph.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td><span class="badge bg-secondary">@ph.Reason</span></td>
                                            <td>@ph.Description</td>
                                            <td class="text-end fw-bold @(ph.Amount > 0 ? "text-success" : "text-danger")">
                                                @(ph.Amount > 0 ? "+" : "")@ph.Amount
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private PointBalanceResponse? balance;
    private UserLevelProgressResponse? levelProgress;
    private StreaksSummaryResponse? streaks;
    private List<UserMissionProgressResponse>? todayMissions;
    private List<AchievementProgressResponse>? recentAchievements;
    private PointHistoryPagedResponse? pointHistory;
    private int historyPage = 1;
    private const int HistoryPageSize = 20;
    private PointReason? historyReason;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            var tasks = new[]
            {
                LoadBalance(),
                LoadLevel(),
                LoadStreaks(),
                LoadTodayMissions(),
                LoadRecentAchievements(),
                LoadHistory(1)
            };
            await Task.WhenAll(tasks);
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro ao carregar dados: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadBalance()
    {
        balance = await gamification.GetMyPointsBalance();
    }

    private async Task LoadLevel()
    {
        levelProgress = await gamification.GetMyLevelProgress();
    }

    private async Task LoadStreaks()
    {
        streaks = await gamification.GetMyStreaks();
    }

    private async Task LoadTodayMissions()
    {
        todayMissions = await gamification.GetMyTodayMissions();
    }

    private async Task LoadRecentAchievements()
    {
        recentAchievements = await gamification.GetMyRecentAchievements(5);
    }

    private async Task LoadHistory(int page)
    {
        historyPage = page;
        var reason = string.IsNullOrEmpty(historyReason.ToString()) ? null : historyReason;
        pointHistory = await gamification.GetMyPointsHistory(page, HistoryPageSize, reason);
    }

    private async Task ClaimReward(UserMissionProgressResponse mission)
    {
        try
        {
            var result = await gamification.ClaimMissionReward(mission.MissionId, "Daily", null);
            if (result.Success)
            {
                await LoadBalance();
                await LoadLevel();
                await LoadTodayMissions();
            }
            else
            {
                errorMessage = result.Error ?? "Não foi possível resgatar a recompensa.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Erro: {ex.Message}";
        }
    }
}
