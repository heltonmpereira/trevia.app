@page "/register"
@inject NavigationManager Nav
@inject TreviaApp.Client.Services.Auth.IAuthService Auth

@using TreviaApp.Client.Services.Auth
@using TreviaApp.Contracts.Authentication
@using Microsoft.AspNetCore.Authorization

<PageTitle>Criar Conta - TreviaApp</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h2 class="text-primary fw-bold mb-2">Criar Conta</h2>
                        <p class="text-muted">Junte-se ao TreviaApp hoje</p>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mb-4" role="alert">
                            @errorMessage
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success mb-4" role="alert">
                            @successMessage
                        </div>
                    }

                    <EditForm Model="@registerRequest" OnValidSubmit="@HandleRegisterAsync" class="needs-validation" novalidate>
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="row g-3 mb-3">
                            <div class="col-md-6 form-group">
                                <label for="firstName" class="form-label">Primeiro Nome</label>
                                <InputText id="firstName" @bind-Value="registerRequest.FirstName" class="form-control form-control-lg" placeholder="Nome" />
                                <ValidationMessage For="@(() => registerRequest.FirstName)" class="text-danger small" />
                            </div>
                            <div class="col-md-6 form-group">
                                <label for="lastName" class="form-label">Sobrenome</label>
                                <InputText id="lastName" @bind-Value="registerRequest.LastName" class="form-control form-control-lg" placeholder="Sobrenome" />
                                <ValidationMessage For="@(() => registerRequest.LastName)" class="text-danger small" />
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            <label for="email" class="form-label">E-mail</label>
                            <InputText id="email" @bind-Value="registerRequest.Email" class="form-control form-control-lg" placeholder="seu@email.com" type="email" />
                            <ValidationMessage For="@(() => registerRequest.Email)" class="text-danger small" />
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6 form-group">
                                <label for="password" class="form-label">Senha</label>
                                <InputText id="password" @bind-Value="registerRequest.Password" class="form-control form-control-lg" placeholder="••••••••" type="password" />
                                <ValidationMessage For="@(() => registerRequest.Password)" class="text-danger small" />
                            </div>
                            <div class="col-md-6 form-group">
                                <label for="confirmPassword" class="form-label">Confirmar Senha</label>
                                <InputText id="confirmPassword" @bind-Value="registerRequest.ConfirmPassword" class="form-control form-control-lg" placeholder="••••••••" type="password" />
                                <ValidationMessage For="@(() => registerRequest.ConfirmPassword)" class="text-danger small" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                <span class="visually-hidden">Carregando</span>
                                <text>Criando conta</text>
                            }
                            else
                            {
                                <text>Criar Conta</text>
                            }
                        </button>

                        <div class="text-center">
                            <p class="mb-0 text-muted">
                                Já tem conta?
                                <a href="javascript:void(0)" @onclick="NavigateToLogin" class="text-decoration-none fw-semibold text-primary">Entrar</a>
                            </p>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private RegisterRequest registerRequest = new();
    private bool isLoading;
    private string? errorMessage;
    private string? successMessage;

    private async Task HandleRegisterAsync()
    {
        isLoading = true;
        errorMessage = null;
        successMessage = null;
        try
        {
            await Auth.RegisterAsync(new RegisterRequest
            {
                FirstName = registerRequest.FirstName,
                LastName = registerRequest.LastName,
                Email = registerRequest.Email,
                Password = registerRequest.Password,
                ConfirmPassword = registerRequest.ConfirmPassword
            });
            successMessage = "Conta criada com sucesso! Redirecionando...";
            Nav.NavigateTo("dashboard", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToLogin()
    {
        Nav.NavigateTo("/login");
    }
}
