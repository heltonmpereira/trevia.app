@page "/login"
@inject NavigationManager Nav
@inject TreviaApp.Client.Services.Auth.IAuthService Auth

@using TreviaApp.Client.Services.Auth
@using TreviaApp.Contracts.Authentication
@using Microsoft.AspNetCore.Authorization

<PageTitle>Login - TreviaApp</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow">
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h2 class="text-primary fw-bold mb-2">TreviaApp</h2>
                        <p class="text-muted">Entre para continuar</p>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger mb-4" role="alert">
                            @errorMessage
                        </div>
                    }

                    <EditForm Model="@loginRequest" OnValidSubmit="@HandleLoginAsync" class="needs-validation" novalidate>
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger mb-3" />

                        <div class="form-group mb-3">
                            <label for="email" class="form-label">E-mail</label>
                            <InputText id="email" @bind-Value="loginRequest.Email" class="form-control form-control-lg" placeholder="seu@email.com" type="email" />
                            <ValidationMessage For="@(() => loginRequest.Email)" class="text-danger small" />
                        </div>

                        <div class="form-group mb-3">
                            <label for="password" class="form-label">Senha</label>
                            <InputText id="password" @bind-Value="loginRequest.Password" class="form-control form-control-lg" placeholder="••••••••" type="password" />
                            <ValidationMessage For="@(() => loginRequest.Password)" class="text-danger small" />
                        </div>

                        <div class="form-group mb-4 d-flex justify-content-between align-items-center">
                            <div class="form-check">
                                <InputCheckbox id="rememberMe" @bind-Value="loginRequest.RememberMe" class="form-check-input" />
                                <label for="rememberMe" class="form-check-label text-muted small">Lembrar-me</label>
                            </div>
                            <a href="javascript:void(0)" @onclick="HandleForgotPassword" class="text-decoration-none small text-primary">Esqueci senha?</a>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 mb-3" disabled="@isLoading">
                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                                <span class="visually-hidden">Carregando</span>
                                <text>Entrando</text>
                            }
                            else
                            {
                                <text>Entrar</text>
                            }
                        </button>

                        <div class="text-center">
                            <p class="mb-0 text-muted">
                                Não tem conta?
                                <a href="javascript:void(0)" @onclick="NavigateToRegister" class="text-decoration-none fw-semibold text-primary">Criar conta</a>
                            </p>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private LoginRequest loginRequest = new();
    private bool isLoading;
    private string? errorMessage;

    private async Task HandleLoginAsync()
    {
        isLoading = true;
        errorMessage = null;
        try
        {
            await Auth.LoginAsync(new LoginRequest
            {
                Email = loginRequest.Email,
                Password = loginRequest.Password,
                RememberMe = loginRequest.RememberMe
            });
            Nav.NavigateTo("dashboard", forceLoad: true);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToRegister()
    {
        Nav.NavigateTo("/register");
    }

    private void HandleForgotPassword()
    {
        errorMessage = "Funcionalidade de recuperação de senha em desenvolvimento.";
    }
}
