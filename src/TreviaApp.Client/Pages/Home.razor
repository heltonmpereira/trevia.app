@page "/"
@inject NavigationManager Nav
@inject TreviaApp.Client.Services.Auth.IAuthService Auth

@using TreviaApp.Client.Services.Auth
@using TreviaApp.Contracts.Authentication
@using Microsoft.AspNetCore.Authorization

<PageTitle>TreviaApp - Plataforma Fitness Gamificada</PageTitle>

@if (isCheckingAuth)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="text-center">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Carregando...</span>
            </div>
            <p class="text-muted">Carregando...</p>
        </div>
    </div>
}
else if (isAuthenticated)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="text-center">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                <span class="visually-hidden">Redirecionando...</span>
            </div>
            <p class="text-muted">Redirecionando para o dashboard...</p>
        </div>
    </div>
}
else
{
    <section class="bg-gradient-to-br from-primary to-primary-dark text-white py-5 overflow-hidden" style="background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 50%, #084298 100%);">
        <div class="container px-4 py-5">
            <div class="row align-items-center g-lg-5 py-5">
                <div class="col-lg-7 text-center text-lg-start">
                    <h1 class="display-4 fw-bold mb-3 lh-1">
                        TreviaApp
                        <span class="d-block text-warning mt-2">Plataforma Fitness Gamificada</span>
                    </h1>
                    <p class="col-lg-10 lead mb-5 text-white-50 fs-4">
                        Transforme seus treinos em uma jornada épica. Ganhe pontos, suba de nível, complete missões diárias e atinja seus objetivos com motivação total.
                    </p>
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center justify-content-lg-start">
                        <button class="btn btn-warning btn-lg px-5 py-3 fw-bold shadow-lg" @onclick="NavigateToRegister">
                            Comece Agora
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-rocket-takeoff ms-2" viewBox="0 0 16 16">
                                <path d="M9.752 6.193c.599.64 1.73.437 1.9.562.038.027.657.558.391 1.405-.27.86-1.275 1.614-1.978 1.978-.847.266-1.378-.353-1.405-.391-.125-.17-.338-1.301-.562-1.9a1.066 1.066 0 0 0-.227-.489 4.61 4.61 0 0 0-.041-.04c-.448-.43-1.694-.71-2.914-.15-.34.154-.604.326-.778.466-.203.163-.295.26-.361.365a3.53 3.53 0 0 1-.265.438c-.159.223-.334.41-.649.41-.267 0-.484-.157-.674-.365l-.463-.5c-.77-.83-1.369-1.491-2.349-2.001a2.156 2.156 0 0 1-.768-.318l.001-.002a.79.79 0 0 1-.23-.216c-.241-.29-.327-.634-.287-1.086l.031-.334C.767 1.607 2.45.001 4.468.001c1.366 0 2.465.584 3.307 1.183.864.617 1.579 1.338 2.14 2.148.243.353.45.705.636 1.064.09.176.172.361.224.525.06.183.112.389.095.576a.54.54 0 0 1-.118.302.99.99 0 0 1-.08.09c-.177.187-.417.355-.92.295z"/>
                            </svg>
                        </button>
                        <button class="btn btn-outline-light btn-lg px-5 py-3 fw-bold border-2" @onclick="NavigateToLogin">
                            Já tenho conta
                        </button>
                    </div>
                    <div class="mt-5 pt-3 d-flex flex-wrap gap-4 justify-content-center justify-content-lg-start">
                        <div class="d-flex align-items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-warning bi bi-check-circle-fill" viewBox="0 0 16 16">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                            </svg>
                            <span class="text-white-75 small fw-medium">Gratuito para começar</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-warning bi bi-check-circle-fill" viewBox="0 0 16 16">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                            </svg>
                            <span class="text-white-75 small fw-medium">PWA - Instale no celular</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="text-warning bi bi-check-circle-fill" viewBox="0 0 16 16">
                                <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                            </svg>
                            <span class="text-white-75 small fw-medium">Funciona offline</span>
                        </div>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="card bg-white bg-opacity-10 backdrop-blur border-0 shadow-lg rounded-4 p-2">
                        <div class="bg-white rounded-3 p-4 text-dark">
                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <div>
                                    <p class="text-muted small mb-0 text-uppercase fw-semibold">Status do Atleta</p>
                                    <h4 class="fw-bold mb-0 text-primary">Nível 12</h4>
                                </div>
                                <div class="bg-warning bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                    <span class="display-6 fw-bold text-warning">🔥</span>
                                </div>
                            </div>
                            <div class="mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-muted fw-medium">XP para nível 13</small>
                                    <small class="fw-bold text-primary">2,450 / 3,000 XP</small>
                                </div>
                                <div class="progress" style="height: 12px;">
                                    <div class="progress-bar bg-gradient-to-r from-primary to-primary-dark progress-bar-striped" role="progressbar" style="width: 81.6%" aria-valuenow="81" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                            <div class="row g-3 mb-3">
                                <div class="col-6">
                                    <div class="bg-primary bg-opacity-10 rounded-3 p-3 text-center">
                                        <p class="small text-muted mb-1 fw-medium">Pontos</p>
                                        <h3 class="fw-bold mb-0 text-primary">12.850</h3>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="bg-success bg-opacity-10 rounded-3 p-3 text-center">
                                        <p class="small text-muted mb-1 fw-medium">Streak</p>
                                        <h3 class="fw-bold mb-0 text-success">24 dias</h3>
                                    </div>
                                </div>
                            </div>
                            <div class="border-top pt-3">
                                <p class="small text-muted mb-2 fw-semibold text-uppercase">Missões de Hoje</p>
                                <div class="space-y-2">
                                    <div class="d-flex align-items-center gap-2 py-1">
                                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 24px; height: 24px;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                                <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                                            </svg>
                                        </div>
                                        <span class="text-decoration-line-through text-muted small">Treino de pernas completo</span>
                                        <span class="ms-auto badge bg-success bg-opacity-10 text-success">+50 pts</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 py-1">
                                        <div class="bg-success text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 24px; height: 24px;">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                                                <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                                            </svg>
                                        </div>
                                        <span class="text-decoration-line-through text-muted small">30 min de cardio</span>
                                        <span class="ms-auto badge bg-success bg-opacity-10 text-success">+30 pts</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2 py-1">
                                        <div class="bg-secondary bg-opacity-25 text-secondary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 24px; height: 24px;">
                                            <span class="small fw-bold">3</span>
                                        </div>
                                        <span class="small fw-medium">Beber 3L de água <span class="text-success ms-1">(2/3)</span></span>
                                        <span class="ms-auto badge bg-primary bg-opacity-10 text-primary">+20 pts</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5 bg-light">
        <div class="container px-4 py-5">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold mb-3">Por que escolher o TreviaApp?</h2>
                <p class="lead text-muted col-lg-8 mx-auto">Tudo que você precisa para transformar sua rotina de treinos em uma experiência motivadora e recompensadora.</p>
            </div>

            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-body p-5 text-center">
                            <div class="bg-primary bg-opacity-10 rounded-4 d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 90px; height: 90px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" fill="currentColor" class="text-primary bi bi-grid-3x3-gap-fill" viewBox="0 0 16 16">
                                    <path d="M1 2a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V2zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V2zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V2zM1 7a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V7zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V7zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1V7zM1 12a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1v-2zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1v-2zm5 0a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-2z"/>
                                </svg>
                            </div>
                            <h4 class="fw-bold mb-3">Planilhas Gamificadas</h4>
                            <p class="text-muted mb-0">
                                Treinos estruturados com sistema de pontos, níveis, conquistas e missões diárias. Cada repetição conta para o seu progresso!
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-body p-5 text-center">
                            <div class="bg-success bg-opacity-10 rounded-4 d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 90px; height: 90px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" fill="currentColor" class="text-success bi bi-wifi-off" viewBox="0 0 16 16">
                                    <path d="M10.706 3.294A12.545 12.545 0 0 0 8 3C5.259 3 2.723 3.882.663 5.379a.485.485 0 0 0-.048.736.518.518 0 0 0 .668.05A11.448 11.448 0 0 1 8 4c.63 0 1.249.05 1.852.148l.854-.854zM8 6c-1.905 0-3.68.56-5.166 1.526a.48.48 0 0 0-.063.745.525.525 0 0 0 .652.065 8.448 8.448 0 0 1 4.572 1.46 8.444 8.444 0 0 1 2.415-1.673.481.481 0 0 0 .651-.087l.262-.3c.203-.233.163-.587-.065-.773A9.44 9.44 0 0 0 8 6zm0 3a5.47 5.47 0 0 0-2.555.637.485.485 0 0 0-.144.694l.089.115a.49.49 0 0 0 .655.109 4.48 4.48 0 0 1 3.91-.007.488.488 0 0 0 .675-.072c.218-.188.256-.508.103-.742A5.47 5.47 0 0 0 8 9zm0 3a2.5 2.5 0 0 0-1.25.333.477.477 0 0 0-.146.687l.514.672a.49.49 0 0 0 .654.115.5.5 0 0 0 .464.003.489.489 0 0 0 .197-.094l.518-.676a.482.482 0 0 0-.144-.684A2.5 2.5 0 0 0 8 12zm-7.94-.21a.484.484 0 0 0-.168.665l.518.677a.49.49 0 0 0 .656.114.5.5 0 0 0 .196-.094L8 10.001l1.044 1.365a.5.5 0 0 0 .196.094.49.49 0 0 0 .656-.114l.518-.677a.484.484 0 0 0-.168-.665L9.374 9.46l1.107-1.446a.484.484 0 0 0-.168-.665l-.518-.677a.49.49 0 0 0-.656-.114.5.5 0 0 0-.196.094L8 8.201 6.956 6.836a.5.5 0 0 0-.196-.094.49.49 0 0 0-.656.114l-.518.677a.484.484 0 0 0-.168.665l1.107 1.446L.06 11.79zm15.192.063L8.509 4.15a.484.484 0 0 0-.678.048l-.442.491a.49.49 0 0 0-.049.672l6.195 8.444a.485.485 0 0 0 .679-.048l.441-.49a.49.49 0 0 0 .049-.673zm-1.995 1.187L10.706 10.5l1.106-1.445a.484.484 0 0 0-.168-.665l-.518-.677a.49.49 0 0 0-.655-.114l-.545.426L7.293 4.51a12.6 12.6 0 0 1 1.414-.26c1.031-.057 2.047.034 3.034.299a.484.484 0 0 0 .679-.048l.441-.49a.49.49 0 0 0 .049-.673A13.54 13.54 0 0 0 8 3c-.852 0-1.685.074-2.491.218l-.52-.67a.485.485 0 0 0-.678-.048l-.441.49a.49.49 0 0 0-.049.672l.61.83-2.14 2.76a.5.5 0 0 0-.144.687l.089.115a.49.49 0 0 0 .654.109l2.436-1.445L2.26 11.72a.5.5 0 0 0-.05.667l.442.49a.49.49 0 0 0 .672.048L13.257 13.04z"/>
                                </svg>
                            </div>
                            <h4 class="fw-bold mb-3">PWA Offline</h4>
                            <p class="text-muted mb-0">
                                Instale como aplicativo no celular ou computador. Acesse seus treinos, registre execuções e sincronize tudo mesmo sem internet.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-body p-5 text-center">
                            <div class="bg-warning bg-opacity-10 rounded-4 d-flex align-items-center justify-content-center mx-auto mb-4" style="width: 90px; height: 90px;">
                                <svg xmlns="http://www.w3.org/2000/svg" width="44" height="44" fill="currentColor" class="text-warning bi bi-person-check-fill" viewBox="0 0 16 16">
                                    <path fill-rule="evenodd" d="M15.854 5.146a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708 0l-1.5-1.5a.5.5 0 0 1 .708-.708L12.5 7.793l2.646-2.647a.5.5 0 0 1 .708 0z"/>
                                    <path d="M1 14s-1 0-1-1 1-4 6-4 6 3 6 4-1 1-1 1H1zm5-6a3 3 0 1 0 0-6 3 3 0 0 0 0 6z"/>
                                </svg>
                            </div>
                            <h4 class="fw-bold mb-3">Coaching Integrado</h4>
                            <p class="text-muted mb-0">
                                Receba feedback personalizado, acompanhamento de desempenho e planilhas adaptativas criadas por profissionais de educação física.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5 bg-dark text-white">
        <div class="container px-4 py-5 text-center">
            <h2 class="display-5 fw-bold mb-4">Pronto para começar sua transformação?</h2>
            <p class="lead text-white-50 mb-5 col-lg-8 mx-auto">
                Junte-se a milhares de atletas que já estão transformando seus treinos com o TreviaApp. É gratuito para começar!
            </p>
            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center">
                <button class="btn btn-warning btn-lg px-5 py-3 fw-bold" @onclick="NavigateToRegister">
                    Criar Conta Gratuita
                </button>
                <button class="btn btn-outline-light btn-lg px-5 py-3 fw-bold border-2" @onclick="NavigateToLogin">
                    Entrar na Minha Conta
                </button>
            </div>
        </div>
    </section>

    <footer class="bg-black text-white-50 py-4">
        <div class="container px-4 text-center">
            <p class="mb-0 small">&copy; @DateTime.Now.Year TreviaApp. Todos os direitos reservados.</p>
        </div>
    </footer>
}

@code {
    private bool isCheckingAuth = true;
    private bool isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        isAuthenticated = await Auth.IsAuthenticatedAsync();
        isCheckingAuth = false;

        if (isAuthenticated)
        {
            Nav.NavigateTo("dashboard", forceLoad: true);
        }
    }

    private void NavigateToRegister()
    {
        Nav.NavigateTo("/register");
    }

    private void NavigateToLogin()
    {
        Nav.NavigateTo("/login");
    }
}
