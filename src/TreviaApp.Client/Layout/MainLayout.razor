@inherits LayoutComponentBase
@using TreviaApp.Client.Services.Auth
@inject IAuthService AuthService
@inject NavigationManager Nav
@implements IAsyncDisposable

<div class="page">
    <PwaInstallBanner />

    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="d-flex align-items-center gap-3">
                @if (_isAuthenticated && _userName != null)
                {
                    <span class="text-muted small">
                        Olá, <strong>@_userName</strong>
                    </span>
                }
                @if (_isAuthenticated)
                {
                    <SyncStatusIndicator ShowText="true" />
                }
            </div>
            <div class="d-flex align-items-center gap-2">
                @if (_isAuthenticated)
                {
                    <button class="btn btn-sm btn-outline-secondary" @onclick="GoToProfile">Perfil</button>
                    <button class="btn btn-sm btn-outline-danger" @onclick="LogoutAsync">Sair</button>
                }
                else
                {
                    <NavLink href="login" class="btn btn-sm btn-outline-primary">Entrar</NavLink>
                    <NavLink href="register" class="btn btn-sm btn-primary ms-1">Criar conta</NavLink>
                }
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    private bool _isAuthenticated;
    private string? _userName;

    protected override async Task OnInitializedAsync()
    {
        AuthService.AuthenticationChangedAsync += OnAuthChanged;
        await RefreshAuthStateAsync();
    }

    private async Task OnAuthChanged()
    {
        await RefreshAuthStateAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RefreshAuthStateAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var me = await AuthService.GetCurrentUserCachedAsync();
                if (me != null)
                {
                    var full = $"{me.FirstName} {me.LastName}".Trim();
                    _userName = string.IsNullOrEmpty(full) ? me.Email : full;
                }
                else
                {
                    _userName = "Usuário";
                }
            }
            else
            {
                _userName = null;
            }
        }
        catch
        {
            _isAuthenticated = false;
            _userName = null;
        }
    }

    private void GoToProfile() => Nav.NavigateTo("profile");

    private async Task LogoutAsync()
    {
        try { await AuthService.LogoutAsync(); } catch { }
        Nav.NavigateTo("login", forceLoad: false);
    }

    public ValueTask DisposeAsync()
    {
        AuthService.AuthenticationChangedAsync -= OnAuthChanged;
        return ValueTask.CompletedTask;
    }
}
