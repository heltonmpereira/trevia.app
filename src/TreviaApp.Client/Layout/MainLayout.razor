@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication
@using TreviaApp.Client.Services.Auth
@inject AuthenticationStateProvider AuthState
@inject IAuthService AuthService
@inject NavigationManager Nav
@implements IAsyncDisposable

<CascadingAuthenticationState>
<div class="page">
    <PwaInstallBanner />
    <SyncStatusIndicator />

    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-3">
                <AuthorizeView>
                    <Authorized>
                        <span class="text-muted small">
                            Olá, <strong>@(context.User.Identity?.Name ?? "Usuário")</strong>
                        </span>
                    </Authorized>
                </AuthorizeView>
            </div>
            <div class="d-flex align-items-center gap-2">
                <AuthorizeView>
                    <Authorized>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="GoToProfile">Perfil</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="LogoutAsync">Sair</button>
                    </Authorized>
                    <NotAuthorized>
                        <NavLink href="login" class="btn btn-sm btn-outline-primary">Entrar</NavLink>
                        <NavLink href="register" class="btn btn-sm btn-primary ms-1">Criar conta</NavLink>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4">
            <AuthorizeView>
                <Authorized>
                    @Body
                </Authorized>
                <NotAuthorized>
                    @Body
                </NotAuthorized>
            </AuthorizeView>
        </article>
    </main>
</div>
</CascadingAuthenticationState>

@code {
    private void GoToProfile() => Nav.NavigateTo("profile");

    private async Task LogoutAsync()
    {
        try { await AuthService.LogoutAsync(); } catch { }
        Nav.NavigateTo("login", forceLoad: true);
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}
